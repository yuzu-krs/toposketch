<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ArchSketch.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- GHSA-v5pm-xwqc-g5wc の修正版へ明示的に昇格 -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <!-- db/*.sql を単一の真実の情報源としてアセンブリに埋め込む（スタートアップ時の自動初期化で使用） -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\db\01_create_database.sql">
      <LogicalName>ArchSketch.Scripts.01_create_database.sql</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\db\02_create_tables.sql">
      <LogicalName>ArchSketch.Scripts.02_create_tables.sql</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\db\03_create_procedures.sql">
      <LogicalName>ArchSketch.Scripts.03_create_procedures.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
